{
  "device_name": "cist-01",
  "wifi_ssid": "YOUR_SSID",
  "wifi_pass": "YOUR_PASS",

  "sensor": {
    "trigger_pin": 5,
    "echo_pin": 18,
    "samples": 5,
    "read_interval_sec": 10
  },

  "tank": {
    "shape": "cylindrical",
    "height_cm": 150,
    "diameter_cm": 120,
    "capacity_liters": 0,
    "empty_distance_cm": 145,
    "full_distance_cm": 10
  },

  "grafana": {
    "url": "http://grafana.altermundi.net:8086/write?db=cto",
    "token": "token:YOUR_TOKEN",
    "send_interval_sec": 10
  },

  "telegram": {
    "enabled": false,
    "chat_id": "",
    "bot_token": "",
    "low_level_threshold_pct": 15,
    "recovery_threshold_pct": 30,
    "sensor_failure_threshold": 3,
    "cooldown_sec": 900
  }
}
