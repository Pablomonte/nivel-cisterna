# Plantilla de credenciales locales para nivel-cisterna.
# Copiar a .env (gitignored) y completar con valores reales:
#
#   cp .env.example .env
#   $EDITOR .env
#   ./scripts/provision_config.sh
#   pio run -e cisterna_dev -t uploadfs
#
# Tambien podes exportarlas en tu shell (~/.bashrc, direnv, etc.) y saltar el .env.

# WiFi STA (opcional, dejar vacio para forzar modo AP-only en primer boot)
WIFI_SSID=
WIFI_PASS=

# Grafana (opcional)
GRAFANA_URL=
GRAFANA_TOKEN=

# Admin del dashboard (opcional, default: admin / cisterna-XXXXXX por MAC)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# OTA - IP del dispositivo para upload por WiFi (pio run -e cisterna_ota -t upload)
OTA_TARGET_IP=
